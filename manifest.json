{
  "manifest_version": 2,
  "name": "Floating Pop-up Windows",
  "version": "1.0.0",
  "description": "Open any link in movable, resizable, minimizable, maximizable, split-screen floating windows.",
  "browser_specific_settings": { "gecko": { "id": "floating-popup-windows@example.local" } },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "storage", "tabs"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Toggle pop-up window mode", "default_icon": "icon.svg" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
